# Desarrollo local: no sobrescribir un .env existente.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambia-esta-clave-solo-en-local
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# No definir DATABASE_URL para continuar con SQLite local.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require&channel_binding=require

# Producción (configurar en Vercel; no copiar secretos a Git):
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=GENERAR_UN_VALOR_ALEATORIO_DE_AL_MENOS_50_CARACTERES
# DJANGO_ALLOWED_HOSTS=DOMINIO_EXACTO_DEL_PROYECTO
# DJANGO_CSRF_TRUSTED_ORIGINS=https://DOMINIO_EXACTO_DEL_PROYECTO
# DATABASE_URL=URL_POSTGRESQL_DE_PROYECTO_B_CON_TLS
# Vercel establece VERCEL=1. Fuera de Vercel, DJANGO_TRUST_PROXY=1
# solo si un proxy controlado elimina cabeceras de origen no confiables.
# DJANGO_LOAD_ENV=0 evita leer .env en verificaciones aisladas.

# Contactos públicos autorizados del negocio, solo en el entorno:
NEGOCIO_WHATSAPP_VISIBLE=
NEGOCIO_WHATSAPP_NUMERO=
NEGOCIO_CORREO=
NEGOCIO_INSTAGRAM=
NEGOCIO_FACEBOOK=
